import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
export { Strings }

// One row = one port of a group (tunnel), with its Public URL.
export struct PortRow {
    group: string,     // friendly group name (falls back to tunnel-id)
    tunnel-id: string, // Real Tunnel ID (stable service key)
    port: int,
    protocol: string,
    url: string,
    expiration: string,
    status: string, // "idle" | "ok" | "warn" | "down" | "host"  (see theme.slint)
}

// Status dot colored by state.
component StatusDot inherits Rectangle {
    in property <string> status: "idle";
    width: 9px;
    height: 9px;
    border-radius: self.width / 2;
    background: Theme.status-color(root.status);
}

// Small chip (protocol, expiration).
component Pill inherits Rectangle {
    in property <string> text;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 6px;
    height: 18px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            color: Theme.muted;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
        }
    }
}

// Themed text button (primary filled / ghost outline).
component TxtButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border;
    background: root.primary ? Theme.accent : Theme.surface;
    opacity: !root.enabled ? 0.45 : (ta.pressed ? 0.8 : (ta.has-hover ? 0.92 : 1.0));

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: root.primary ? Theme.accent-text : Theme.text;
            font-size: Theme.fs-body;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    title: "DevTunnel GUI";
    preferred-width: 820px;
    preferred-height: 560px;
    min-width: 560px;
    min-height: 380px;
    background: Theme.bg;

    in property <[PortRow]> rows;
    in property <string> status: Strings.status-loading;

    callback refresh();
    callback copy-url(string);
    callback open-url(string);

    VerticalLayout {
        // ---- Top bar ----
        Rectangle {
            background: Theme.surface;
            height: 52px;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: Theme.gap;
                Text {
                    text: "Dev Tunnels";
                    color: Theme.text;
                    font-size: Theme.fs-title;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Pill { text: root.status; }
                TxtButton {
                    text: Strings.btn-refresh;
                    primary: true;
                    clicked => {
                        root.refresh();
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- List ----
        ListView {
            for row in root.rows : Rectangle {
                height: 56px;
                hover := TouchArea { }
                background: hover.has-hover ? Theme.surface-2 : transparent;

                HorizontalLayout {
                    padding-left: Theme.pad;
                    padding-right: Theme.pad;
                    spacing: 10px;

                    // status
                    VerticalLayout {
                        alignment: center;
                        StatusDot { status: row.status; }
                    }

                    // port + url + meta
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "\{row.port}";
                                color: Theme.text;
                                font-size: Theme.fs-section;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Pill { text: row.protocol == "" ? "—" : row.protocol; }
                            Text {
                                text: row.url == "" ? Strings.no-url : row.url;
                                color: row.url == "" ? Theme.muted : Theme.accent;
                                font-size: Theme.fs-body;
                                font-family: Theme.mono;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: row.group == row.tunnel-id
                                ? "\{row.tunnel-id} · \{Strings.expires-label}: \{row.expiration}"
                                : "\{row.group} (\{row.tunnel-id}) · \{Strings.expires-label}: \{row.expiration}";
                            color: Theme.muted;
                            font-size: Theme.fs-caption;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 6px;
                            TxtButton {
                                text: Strings.btn-copy;
                                enabled: row.url != "";
                                clicked => {
                                    root.copy-url(row.url);
                                }
                            }
                            TxtButton {
                                text: Strings.btn-open;
                                enabled: row.url != "";
                                clicked => {
                                    root.open-url(row.url);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
