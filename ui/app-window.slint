import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { TxtButton } from "controls.slint";
import { CreateGroupDialog, AddPortDialog, ConfirmDialog, GroupItem } from "dialogs.slint";
import { Pill } from "pill.slint";
import { IconButton } from "icon-button.slint";
import { GroupCard, GroupView, PortView } from "group-card.slint";
import { Toast } from "toast.slint";
import { EmptyState } from "empty-state.slint";
import { PreflightBanner } from "banner.slint";
import { SettingsDialog } from "settings.slint";
export { Strings, Theme, GroupView, PortView }

export component AppWindow inherits Window {
    title: Strings.app-title;
    preferred-width: 820px;
    preferred-height: 560px;
    min-width: 560px;
    min-height: 380px;
    background: Theme.bg;

    // Groups (tunnels) with their nested ports, folded in Rust from the flat CLI rows.
    in property <[GroupView]> groups;
    in property <string> status: Strings.status-loading;
    // Group picker data for the "Add port" dialog (parallel arrays; the
    // "+ New group…" entry is last, with an empty id).
    in property <[string]> group-names;
    in property <[string]> group-ids;

    in-out property <bool> show-create-group;
    in-out property <bool> show-add-port;
    in-out property <bool> show-confirm;
    in-out property <bool> show-settings;
    // Uninstall confirmation overlay (opened from Settings → Uninstall).
    in-out property <bool> show-uninstall-confirm;

    // True only in the `hosting` build; gates the per-group Host/Stop toggle.
    in property <bool> hosting-enabled: false;

    // ---- Port detail panel (expanded row) ----
    // Index of the expanded row in `rows`, -1 = collapsed. Owned by Rust:
    // toggle-detail records the selection and recomputes this after reloads.
    in-out property <int> selected-index: -1;
    // Pre-formatted metric values for the selected port ("n/a" when missing).
    in property <string> detail-upload-total: Strings.metric-na;
    in property <string> detail-upload-rate: Strings.metric-na;
    in property <string> detail-download-total: Strings.metric-na;
    in property <string> detail-download-rate: Strings.metric-na;
    in property <string> detail-connections: Strings.metric-na;
    // Most recent captured log lines (oldest first).
    in property <[string]> detail-logs;

    // App-level preflight state: "ready" | "cli-missing" | "relogin".
    // Non-ready states show the PreflightBanner above the list. The "relogin"
    // state also covers the expired CLI sign-in case.
    in property <string> app-state: "ready";

    // Settings: current "start with Windows" state (set from Rust at startup).
    in-out property <bool> auto-start-enabled;
    // Settings: health probe cadence + default expiration (issue #6); seeded
    // from the persisted settings by Rust, edited via the Settings dialog.
    in-out property <int> probe-interval-secs;
    // Default expiration for new groups, in whole days (max 30). The CLI "d"
    // suffix is added in Rust; the UI only ever deals in days.
    in-out property <int> default-expiration-days: 30;
    // App version string (from Cargo), shown in the About panel.
    in property <string> app-version;

    // Settings → Requirements checklist: per-item satisfied/not flags, refreshed
    // by Rust when the dialog opens and after install/auto-start actions.
    in property <bool> req-cli-ok;
    in property <bool> req-login-ok;
    in property <bool> req-installed-ok;
    in property <bool> req-shortcut-ok;
    in property <bool> req-autostart-ok;
    // The user clicked "Install CLI" in the requirements checklist.
    callback install-cli();

    callback refresh();
    // Asks Rust to re-sync `auto-start-enabled` from the registry, then open the
    // Settings dialog.
    callback open-settings();
    // The user toggled the auto-start checkbox in the settings dialog.
    callback auto-start-changed(bool);
    // The user edited the probe interval / default expiration in the settings dialog.
    callback probe-interval-changed(int);
    callback default-expiration-changed(int /*days*/);
    // The user toggled dark mode via the top-bar affordance (persist the choice).
    callback theme-changed(bool /*dark*/);
    // The user clicked "Sign in" in the re-login banner.
    callback sign-in();
    // The user confirmed the uninstall: remove shortcut + auto-start, then self-delete.
    callback uninstall-confirmed();
    // Start / stop hosting a group (by Real Tunnel ID).
    callback host(string /*tunnel-id*/);
    callback stop(string /*tunnel-id*/);
    callback copy-url(string);
    callback open-url(string);
    callback create-group(string /*name*/, int /*expiration-days*/, bool /*anonymous*/,
                          string /*description*/, bool /*keep-headers*/, string /*request-timeout*/);
    callback add-port(string /*group-id*/, string /*new-name*/, string /*port*/,
                      string /*protocol*/, string /*description*/, bool /*keep-headers*/, string /*request-timeout*/);
    // Open the confirmation dialog (Rust composes the localized message + remembers the target).
    callback request-delete-group(string /*name*/, string /*tunnel-id*/);
    callback request-delete-port(string /*group*/, string /*tunnel-id*/, int /*port*/);
    // User confirmed the pending deletion.
    callback confirm-accept();
    // Row click: expand/collapse the detail panel for (index, tunnel-id, port).
    callback toggle-detail(int /*index*/, string /*tunnel-id*/, int /*port*/);

    // Copy + show the "URL copied" toast (URL click and ⧉ button both land here).
    function do-copy(url: string) {
        root.copy-url(url);
        toast.show();
    }

    VerticalLayout {
        width: 100%;
        height: 100%;

        // ---- Top bar ----
        Rectangle {
            background: Theme.surface;
            height: Theme.topbar-height;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: Theme.gap;
                Text {
                    text: Strings.app-title;
                    color: Theme.text;
                    font-size: Theme.fs-title;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Pill { text: root.status; }
                }
                VerticalLayout {
                    alignment: center;
                    TxtButton {
                        text: Strings.btn-add-port;
                        clicked => {
                            root.show-add-port = true;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TxtButton {
                        text: Strings.btn-refresh;
                        primary: true;
                        clicked => {
                            root.refresh();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    // Settings dialog: auto-start toggle (issues #5/#13).
                    TxtButton {
                        text: Strings.btn-settings;
                        clicked => {
                            root.open-settings();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    // Dark-mode toggle: shows the target mode (moon to go dark,
                    // sun to go light). The choice is persisted via theme-changed.
                    IconButton {
                        glyph: Theme.dark ? Theme.ico-light : Theme.ico-dark;
                        tip: Strings.tooltip-settings;
                        always-visible: true;
                        // Top-right corner: show the tip to the left so the
                        // window edge never clips it.
                        tip-left: true;
                        clicked => {
                            Theme.dark = !Theme.dark;
                            root.theme-changed(Theme.dark);
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- Preflight banner (CLI missing / re-login) — issue #14 ----
        if root.app-state != "ready" : PreflightBanner {
            app-state: root.app-state;
            sign-in => {
                root.sign-in();
            }
        }

        // ---- Group cards / empty state ----
        if root.groups.length == 0 : EmptyState {
            vertical-stretch: 1;
            create-group => {
                root.show-create-group = true;
            }
        }
        if root.groups.length > 0 : ListView {
            vertical-stretch: 1;
            for g in root.groups : VerticalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                padding-top: Theme.gap;
                GroupCard {
                    gv: g;
                    hosting-enabled: root.hosting-enabled;
                    // Detail panel state (issue #17): which port is expanded and
                    // its pre-formatted metric/log values.
                    selected-index: root.selected-index;
                    detail-upload-total: root.detail-upload-total;
                    detail-upload-rate: root.detail-upload-rate;
                    detail-download-total: root.detail-download-total;
                    detail-download-rate: root.detail-download-rate;
                    detail-connections: root.detail-connections;
                    detail-logs: root.detail-logs;
                    host => {
                        root.host(g.tunnel-id);
                    }
                    stop => {
                        root.stop(g.tunnel-id);
                    }
                    copy-url(url) => {
                        root.do-copy(url);
                    }
                    open-url(url) => {
                        root.open-url(url);
                    }
                    delete-port(port) => {
                        root.request-delete-port(g.group, g.tunnel-id, port);
                    }
                    delete-group => {
                        root.request-delete-group(g.group, g.tunnel-id);
                    }
                    toggle-detail(idx, tid, port) => {
                        root.toggle-detail(idx, tid, port);
                    }
                }
            }
        }

        // ---- Bottom bar ----
        Rectangle {
            height: Theme.topbar-height;
            HorizontalLayout {
                padding: Theme.pad;
                alignment: end;
                TxtButton {
                    text: Strings.btn-create-group;
                    primary: true;
                    clicked => {
                        root.show-create-group = true;
                    }
                }
            }
        }
    }

    // ---- Toast (bottom center, above the bottom bar) ----
    toast := Toast {
        message: Strings.toast-copied;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - Theme.topbar-height - Theme.gap;
    }

    // ---- Modal overlays (drawn on top of the content) ----
    CreateGroupDialog {
        width: 100%;
        height: 100%;
        open <=> root.show-create-group;
        default-expiration-days: root.default-expiration-days;
        submit(name, expiration-days, anonymous, description, keep-headers, request-timeout) => {
            root.create-group(name, expiration-days, anonymous, description, keep-headers, request-timeout);
        }
    }
    AddPortDialog {
        width: 100%;
        height: 100%;
        open <=> root.show-add-port;
        group-names: root.group-names;
        group-ids: root.group-ids;
        submit(group-id, new-name, port, protocol, description, keep-headers, request-timeout) => {
            root.add-port(group-id, new-name, port, protocol, description, keep-headers, request-timeout);
        }
    }
    ConfirmDialog {
        width: 100%;
        height: 100%;
        open <=> root.show-confirm;
        accept => {
            root.confirm-accept();
        }
    }
    SettingsDialog {
        width: 100%;
        height: 100%;
        open <=> root.show-settings;
        auto-start <=> root.auto-start-enabled;
        auto-start-changed(enabled) => {
            root.auto-start-changed(enabled);
        }
        probe-interval <=> root.probe-interval-secs;
        probe-interval-changed(secs) => {
            root.probe-interval-changed(secs);
        }
        default-expiration-days <=> root.default-expiration-days;
        default-expiration-changed(days) => {
            root.default-expiration-changed(days);
        }
        app-version: root.app-version;
        req-cli-ok: root.req-cli-ok;
        req-login-ok: root.req-login-ok;
        req-installed-ok: root.req-installed-ok;
        req-shortcut-ok: root.req-shortcut-ok;
        req-autostart-ok: root.req-autostart-ok;
        install-cli => {
            root.install-cli();
        }
        sign-in => {
            root.sign-in();
        }
        open-url(url) => {
            root.open-url(url);
        }
        // Close Settings and raise the uninstall confirmation overlay.
        uninstall => {
            root.show-settings = false;
            root.show-uninstall-confirm = true;
        }
    }
    ConfirmDialog {
        width: 100%;
        height: 100%;
        open <=> root.show-uninstall-confirm;
        message: Strings.confirm-uninstall;
        accept-text: Strings.btn-uninstall;
        accept => {
            root.uninstall-confirmed();
        }
    }
}
