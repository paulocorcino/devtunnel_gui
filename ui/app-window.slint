import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { TxtButton } from "controls.slint";
import { CreateGroupDialog, AddPortDialog, ConfirmDialog, GroupItem } from "dialogs.slint";
import { StatusDot } from "status-dot.slint";
import { Pill } from "pill.slint";
export { Strings }

// One row = one port of a group (tunnel), with its Public URL.
export struct PortRow {
    group: string,     // friendly group name (falls back to tunnel-id)
    tunnel-id: string, // Real Tunnel ID (stable service key)
    port: int,
    protocol: string,
    url: string,
    expiration: string,
    status: string, // "idle" | "ok" | "warn" | "down" | "host" | "provisioning"  (see theme.slint)
    host-state: string, // "" (not hosting) | "hosting" — drives the group toggle label
}

export component AppWindow inherits Window {
    title: "DevTunnel GUI";
    preferred-width: 820px;
    preferred-height: 560px;
    min-width: 560px;
    min-height: 380px;
    background: Theme.bg;

    in property <[PortRow]> rows;
    in property <string> status: Strings.status-loading;
    // Group picker data for the "Add port" dialog (parallel arrays; the
    // "+ New group…" entry is last, with an empty id).
    in property <[string]> group-names;
    in property <[string]> group-ids;

    in-out property <bool> show-create-group;
    in-out property <bool> show-add-port;
    in-out property <bool> show-confirm;

    // True only in the `hosting` build; gates the per-group Host/Stop toggle.
    in property <bool> hosting-enabled: false;

    callback refresh();
    // Start / stop hosting a group (by Real Tunnel ID).
    callback host(string /*tunnel-id*/);
    callback stop(string /*tunnel-id*/);
    callback copy-url(string);
    callback open-url(string);
    callback create-group(string /*name*/, string /*expiration*/, bool /*anonymous*/,
                          string /*description*/, bool /*keep-headers*/, string /*request-timeout*/);
    callback add-port(string /*group-id*/, string /*new-name*/, string /*port*/,
                      string /*protocol*/, string /*description*/, bool /*keep-headers*/, string /*request-timeout*/);
    // Open the confirmation dialog (Rust composes the localized message + remembers the target).
    callback request-delete-group(string /*name*/, string /*tunnel-id*/);
    callback request-delete-port(string /*group*/, string /*tunnel-id*/, int /*port*/);
    // User confirmed the pending deletion.
    callback confirm-accept();

    VerticalLayout {
        width: 100%;
        height: 100%;
        // ---- Top bar ----
        Rectangle {
            background: Theme.surface;
            height: 52px;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: Theme.gap;
                Text {
                    text: "Dev Tunnels";
                    color: Theme.text;
                    font-size: Theme.fs-title;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Pill { text: root.status; }
                TxtButton {
                    text: Strings.btn-new-group;
                    clicked => {
                        root.show-create-group = true;
                    }
                }
                TxtButton {
                    text: Strings.btn-add-port;
                    clicked => {
                        root.show-add-port = true;
                    }
                }
                TxtButton {
                    text: Strings.btn-refresh;
                    primary: true;
                    clicked => {
                        root.refresh();
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        // ---- List ----
        ListView {
            for row in root.rows : Rectangle {
                height: 56px;
                hover := TouchArea { }
                background: hover.has-hover ? Theme.surface-2 : transparent;

                HorizontalLayout {
                    padding-left: Theme.pad;
                    padding-right: Theme.pad;
                    spacing: 10px;

                    // status dot + health badge
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                StatusDot { status: row.status; }
                            }
                            // Localized badge label for health states and provisioning; hidden when idle/host.
                            if row.status == "ok" || row.status == "warn" || row.status == "down" || row.status == "provisioning" :
                            Pill {
                                text: row.status == "ok"
                                    ? Strings.badge-operational
                                    : (row.status == "warn"
                                        ? Strings.badge-service-down
                                        : (row.status == "down"
                                            ? Strings.badge-down
                                            : Strings.badge-provisioning));
                            }
                        }
                    }

                    // port + url + meta
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "\{row.port}";
                                color: Theme.text;
                                font-size: Theme.fs-section;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Pill { text: row.protocol == "" ? "—" : row.protocol; }
                            Text {
                                text: row.url == "" ? Strings.no-url : row.url;
                                color: row.url == "" ? Theme.muted : Theme.accent;
                                font-size: Theme.fs-body;
                                font-family: Theme.mono;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: row.group == row.tunnel-id
                                ? "\{row.tunnel-id} · \{Strings.expires-label}: \{row.expiration}"
                                : "\{row.group} (\{row.tunnel-id}) · \{Strings.expires-label}: \{row.expiration}";
                            color: Theme.muted;
                            font-size: Theme.fs-caption;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 6px;
                            // Per-group Host/Stop toggle. Disabled in the default
                            // (non-hosting) build; label reflects the group state.
                            TxtButton {
                                text: row.host-state == "hosting" ? Strings.btn-stop : Strings.btn-host;
                                primary: row.host-state != "hosting";
                                // Hosting a group with no port forwards nothing, so only
                                // enable Host when the group has a port (or to Stop an
                                // already-hosting group). A port==0 row is a portless group.
                                // Provisioning rows are inert.
                                enabled: root.hosting-enabled && row.status != "provisioning" && (row.port != 0 || row.host-state == "hosting");
                                clicked => {
                                    if (row.host-state == "hosting") {
                                        root.stop(row.tunnel-id);
                                    } else {
                                        root.host(row.tunnel-id);
                                    }
                                }
                            }
                            TxtButton {
                                text: Strings.btn-copy;
                                enabled: row.url != "";
                                clicked => {
                                    root.copy-url(row.url);
                                }
                            }
                            TxtButton {
                                text: Strings.btn-open;
                                enabled: row.url != "";
                                clicked => {
                                    root.open-url(row.url);
                                }
                            }
                            TxtButton {
                                text: Strings.btn-del-port;
                                danger: true;
                                // A port==0 row is a group with no ports yet; provisioning rows are inert.
                                enabled: row.port != 0 && row.status != "provisioning";
                                clicked => {
                                    root.request-delete-port(row.group, row.tunnel-id, row.port);
                                }
                            }
                            TxtButton {
                                text: Strings.btn-del-group;
                                danger: true;
                                enabled: row.status != "provisioning";
                                clicked => {
                                    root.request-delete-group(row.group, row.tunnel-id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- Modal overlays (drawn on top of the content) ----
    CreateGroupDialog {
        width: 100%;
        height: 100%;
        open <=> root.show-create-group;
        submit(name, expiration, anonymous, description, keep-headers, request-timeout) => {
            root.create-group(name, expiration, anonymous, description, keep-headers, request-timeout);
        }
    }
    AddPortDialog {
        width: 100%;
        height: 100%;
        open <=> root.show-add-port;
        group-names: root.group-names;
        group-ids: root.group-ids;
        submit(group-id, new-name, port, protocol, description, keep-headers, request-timeout) => {
            root.add-port(group-id, new-name, port, protocol, description, keep-headers, request-timeout);
        }
    }
    ConfirmDialog {
        width: 100%;
        height: 100%;
        open <=> root.show-confirm;
        accept => {
            root.confirm-accept();
        }
    }
}
