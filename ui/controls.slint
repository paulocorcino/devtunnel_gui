// Shared, themed controls reused across the app and dialogs.
// Project rule: no hard-coded color or size — always go through Theme.*.
import { Theme } from "theme.slint";

// Themed text button. Variants: primary (filled accent), danger (red outline),
// or default (neutral outline).
export component TxtButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    border-radius: Theme.radius;
    border-width: root.primary ? 0px : 1px;
    border-color: root.danger ? Theme.down : Theme.border;
    background: root.primary ? Theme.accent : Theme.surface;
    opacity: !root.enabled ? 0.45 : (ta.pressed ? 0.8 : (ta.has-hover ? 0.92 : 1.0));

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: root.primary ? Theme.accent-text : (root.danger ? Theme.down : Theme.text);
            font-size: Theme.fs-body;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}
