// Translatable UI strings. All values are set from Rust at startup via
// app.global::<Strings>().set_*(...). Default values are English fallbacks
// so the UI renders correctly even before the locale is applied.
export global Strings {
    // True in Microsoft Store (MSIX) builds. Hides the self-install, uninstall,
    // and HKCU auto-start controls, which the package manages itself (auto-start
    // is declared via the manifest's windows.startupTask and toggled in Windows
    // Settings > Startup apps). Set from Rust; defaults false for the portable build.
    in property <bool> store-build: false;

    // Status bar
    in property <string> status-loading:    "loading…";
    in property <string> status-refreshing: "refreshing…";

    // Top bar
    in property <string> btn-refresh: "Refresh";
    in property <string> btn-new-group: "New group";
    in property <string> btn-add-port: "Add port";
    in property <string> btn-settings: "Settings";

    // Port list
    in property <string> no-url:       "(no URL — port not configured)";
    in property <string> expires-label: "expires";

    // Port row actions
    in property <string> btn-copy: "Copy";
    in property <string> btn-open: "Open";

    // Hosting
    in property <string> btn-host: "Host";
    in property <string> btn-stop: "Stop";
    in property <string> status-hosting: "hosting…";
    in property <string> status-stopped: "stopped";

    // Health badges
    in property <string> badge-operational: "Operational";
    in property <string> badge-service-down: "Service down";
    in property <string> badge-down: "Down";
    in property <string> badge-provisioning: "Provisioning…";
    in property <string> badge-hosted-external: "Hosted elsewhere";
    in property <string> btn-del-port: "Delete port";
    in property <string> btn-del-group: "Delete group";

    // Dialogs — common
    in property <string> btn-cancel: "Cancel";
    in property <string> btn-create: "Create";
    in property <string> btn-add: "Add";
    in property <string> btn-delete: "Delete";
    in property <string> dlg-advanced: "Advanced";
    in property <string> dlg-keep-headers: "Keep original Host/Origin headers";
    in property <string> dlg-request-timeout: "Request timeout (seconds)";
    in property <string> ph-request-timeout: "0 = disabled";
    // Unit suffix shown after the numeric expiration field (max 30 days).
    in property <string> unit-days: "days";

    // Dialog — new group
    in property <string> dlg-new-group-title: "New group";
    in property <string> field-name: "Name";
    in property <string> field-expiration: "Expiration";
    in property <string> field-anonymous: "Allow anonymous access";
    in property <string> field-description: "Description";
    in property <string> ph-group-name: "e.g. frontend";
    in property <string> ph-expiration: "e.g. 30d";
    in property <string> ph-description: "optional";

    // Dialog — add port
    in property <string> dlg-add-port-title: "Add port";
    in property <string> field-group: "Group";
    in property <string> field-port: "Port number";
    in property <string> field-protocol: "Protocol";
    in property <string> new-group-option: "+ New group…";
    in property <string> ph-port: "e.g. 3000";

    // Dialog — inline validation messages
    in property <string> err-field-name-required: "Name is required.";
    in property <string> err-field-port-required: "Port number is required.";
    in property <string> err-field-port-range: "Port must be between 1 and 65535.";

    // Status-dot tooltip labels (health states reuse the badge-* strings)
    in property <string> badge-stopped: "Stopped";
    in property <string> badge-hosting: "Hosting…";

    // Top bar (redesign)
    in property <string> app-title: "Dev Tunnels Manager";
    in property <string> pill-connected: "Connected";
    in property <string> tooltip-settings: "Toggle dark mode";

    // Row action tooltips
    in property <string> tooltip-copy: "Copy URL";
    in property <string> tooltip-open: "Open in browser";

    // Toast
    in property <string> toast-copied: "URL copied";

    // Empty state
    in property <string> empty-title: "No groups yet";
    in property <string> btn-create-group: "+ Create group";

    // Port detail panel
    in property <string> tab-metrics: "Metrics";
    in property <string> tab-logs: "Logs";
    in property <string> metric-upload: "Upload";
    in property <string> metric-download: "Download";
    in property <string> metric-total: "Total";
    in property <string> metric-rate: "Rate";
    in property <string> metric-connections: "Connections";
    in property <string> metric-active: "Active";
    in property <string> metric-na: "n/a";
    in property <string> logs-empty: "No log entries yet.";

    // Settings — requirements checklist
    in property <string> req-title: "Requirements";
    in property <string> req-cli: "Dev Tunnels CLI installed";
    in property <string> req-login: "Signed in";
    in property <string> req-login-as: "Signed in as";
    in property <string> req-installed: "Installed in your programs folder";
    in property <string> req-shortcut: "Start-menu shortcut created";
    in property <string> req-autostart: "Starts with Windows";
    in property <string> btn-install-cli: "Install CLI";
    in property <string> req-install-hint: "Turning on \"Start with Windows\" installs the app into your user programs folder, adds a Start-menu shortcut, and enables auto-start.";

    // Settings
    in property <string> settings-title: "Settings";
    in property <string> settings-section-general: "General";
    in property <string> settings-section-status: "Status";
    in property <string> settings-section-about: "About";
    in property <string> field-auto-start: "Start with Windows";
    in property <string> field-probe-interval: "Probe interval (seconds)";
    in property <string> field-default-expiration: "Default expiration";
    in property <string> field-log-level: "Log level";
    in property <string> log-level-error: "Error";
    in property <string> log-level-warn: "Warning";
    in property <string> log-level-info: "Info";
    in property <string> log-level-debug: "Debug";
    in property <string> btn-close: "Close";
    in property <string> btn-uninstall: "Uninstall";
    in property <string> confirm-uninstall: "Uninstall DevTunnel GUI? This removes the Start-menu shortcut, turns off start-with-Windows, deletes your saved settings, and removes the app from your programs folder.";

    // About
    in property <string> about-title: "About";
    in property <string> about-app-name: "Dev Tunnels Manager";
    in property <string> about-version-label: "Version";
    in property <string> about-tagline: "Manage Microsoft Dev Tunnels from your Windows tray.";
    in property <string> about-built-on: "Built on Microsoft Dev Tunnels — Microsoft's free, security-focused tunneling service — and its official CLI and SDK. Not affiliated with or endorsed by Microsoft.";
    in property <string> about-created-by: "Created by Paulo Corcino";
    in property <string> about-link-docs: "Microsoft Dev Tunnels docs";
    in property <string> about-link-repo: "Project on GitHub";
    in property <string> about-link-license: "MIT License";

    // Preflight banner / re-login
    in property <string> banner-cli-missing-title: "Dev Tunnels CLI not found";
    in property <string> banner-cli-missing-body: "The `devtunnel` CLI is required but was not found on PATH.";
    in property <string> banner-cli-missing-install: "Install it with: winget install Microsoft.devtunnel — or set DEVTUNNEL_BIN to the executable path.";
    in property <string> banner-relogin-title: "Sign in required";
    in property <string> banner-relogin-body: "Your Dev Tunnels login is missing or has expired. Sign in to continue.";
    in property <string> relogin-message: "Sign-in expired — sign in again to keep hosting";
    in property <string> btn-sign-in: "Sign in";
    in property <string> banner-action-open-settings: "Open Settings";

    // Update available banner (update-banner-body is filled from Rust with the
    // release version, so it has no static default).
    in property <string> update-banner-title: "Update available";
    in property <string> update-banner-body;
    in property <string> btn-update-download: "View release";
    in property <string> btn-update-ignore: "Ignore";

    // Install CLI progress / outcome
    in property <string> install-status-running: "Installing…";
    in property <string> install-status-done: "Dev Tunnels CLI installed";
    in property <string> install-status-failed: "Install failed";
    in property <string> install-status-elevation: "Install needs administrator rights — opening the manual install page";
    in property <string> install-status-winget-missing: "winget not available — opening the manual install page";

    // Confirmation dialog (message text is set from Rust with arguments)
    in property <string> confirm-message: "";
}
