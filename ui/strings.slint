// Translatable UI strings. All values are set from Rust at startup via
// app.global::<Strings>().set_*(...). Default values are English fallbacks
// so the UI renders correctly even before the locale is applied.
export global Strings {
    // Status bar
    in property <string> status-loading:    "loading…";
    in property <string> status-refreshing: "refreshing…";

    // Top bar
    in property <string> btn-refresh: "Refresh";
    in property <string> btn-new-group: "New group";
    in property <string> btn-add-port: "Add port";

    // Port list
    in property <string> no-url:       "(no URL — port not configured)";
    in property <string> expires-label: "expires";

    // Port row actions
    in property <string> btn-copy: "Copy";
    in property <string> btn-open: "Open";

    // Hosting
    in property <string> btn-host: "Host";
    in property <string> btn-stop: "Stop";
    in property <string> status-hosting: "hosting…";
    in property <string> status-stopped: "stopped";

    // Health badges
    in property <string> badge-operational: "Operational";
    in property <string> badge-service-down: "Service down";
    in property <string> badge-down: "Down";
    in property <string> badge-provisioning: "Provisioning…";
    in property <string> btn-del-port: "Delete port";
    in property <string> btn-del-group: "Delete group";

    // Dialogs — common
    in property <string> btn-cancel: "Cancel";
    in property <string> btn-create: "Create";
    in property <string> btn-add: "Add";
    in property <string> btn-delete: "Delete";
    in property <string> dlg-advanced: "Advanced";
    in property <string> dlg-keep-headers: "Keep original Host/Origin headers";
    in property <string> dlg-request-timeout: "Request timeout (seconds)";
    in property <string> ph-request-timeout: "0 = disabled";

    // Dialog — new group
    in property <string> dlg-new-group-title: "New group";
    in property <string> field-name: "Name";
    in property <string> field-expiration: "Expiration";
    in property <string> field-anonymous: "Allow anonymous access";
    in property <string> field-description: "Description";
    in property <string> ph-group-name: "e.g. frontend";
    in property <string> ph-expiration: "e.g. 30d";
    in property <string> ph-description: "optional";

    // Dialog — add port
    in property <string> dlg-add-port-title: "Add port";
    in property <string> field-group: "Group";
    in property <string> field-port: "Port number";
    in property <string> field-protocol: "Protocol";
    in property <string> new-group-option: "+ New group…";
    in property <string> ph-port: "e.g. 3000";

    // Status-dot tooltip labels (health states reuse the badge-* strings)
    in property <string> badge-stopped: "Stopped";
    in property <string> badge-hosting: "Hosting…";

    // Top bar (redesign)
    in property <string> app-title: "Dev Tunnels";
    in property <string> pill-connected: "Connected";
    in property <string> tooltip-settings: "Toggle dark mode";

    // Row action tooltips
    in property <string> tooltip-copy: "Copy URL";
    in property <string> tooltip-open: "Open in browser";

    // Toast
    in property <string> toast-copied: "URL copied";

    // Empty state
    in property <string> empty-title: "No groups yet";
    in property <string> btn-create-group: "+ Create group";

    // Confirmation dialog (message text is set from Rust with arguments)
    in property <string> confirm-message: "";
}
