// Single source of truth for colors, spacing, and typography. See docs/design/0001-ui-design.md.
// Project rule: no component hard-codes a color or size — always use Theme.*.

export global Theme {
    // Toggle dark mode from Rust:
    //   app.global::<Theme>().set_dark(true)
    in-out property <bool> dark: false;

    // Surfaces — cool slate in dark mode, echoing the ngrok-style palette.
    out property <color> bg:        dark ? #0b0e14 : #ffffff;
    out property <color> surface:   dark ? #141821 : #f7f8fa;
    out property <color> surface-2: dark ? #1c2230 : #ffffff;
    out property <color> border:    dark ? #232a38 : #e5e7eb;

    // Text
    out property <color> text:  dark ? #e6e8ee : #1f2330;
    out property <color> muted: dark ? #9aa3b2 : #6b7280;

    // Accent — teal/emerald, the ngrok-style signature. Kept distinct in hue
    // from `ok` (grass green) so "this is the brand / clickable" never reads as
    // "this is healthy".
    out property <color> accent:      dark ? #2dd4bf : #0d9488;
    out property <color> accent-text: dark ? #07120f : #ffffff;

    // Dimmed backdrop behind modal dialogs.
    out property <color> scrim: #00000099;

    // Status — `ok` is pushed toward a warmer grass green so it stays clearly
    // separate from the teal accent above.
    out property <color> ok:           dark ? #4ade80 : #15803d;
    out property <color> warn:         dark ? #f59e0b : #d97706;
    out property <color> down:         dark ? #ef4444 : #dc2626;
    out property <color> idle:         #9ca3af;
    out property <color> provisioning: dark ? #a78bfa : #7c3aed;

    // Metrics — 8px spacing scale
    out property <length> radius: 8px;
    out property <length> gap-sm: 4px;
    out property <length> gap:    8px;
    out property <length> gap-lg: 16px;
    out property <length> pad:    12px;
    // Port detail panel (expanded row)
    out property <length> detail-height: 190px;

    // Control sizes
    out property <length> dot-size:        9px;
    out property <length> pill-height:     18px;
    out property <length> btn-height:      30px;
    out property <length> icon-btn-size:   26px;
    out property <length> toggle-width:    36px;
    out property <length> toggle-height:   20px;
    out property <length> toggle-knob:     14px;

    // Layout metrics
    out property <length> topbar-height:   52px;
    out property <length> row-height:      40px;
    out property <length> card-header-height: 44px;
    out property <length> dialog-width:    380px;
    out property <length> empty-card-width: 320px;

    // Toast
    out property <length>   toast-height:   34px;
    out property <duration> toast-duration: 2400ms;

    // Typography
    out property <length> fs-title:   17px;
    out property <length> fs-section: 13px;
    out property <length> fs-body:    12px;
    out property <length> fs-caption: 11px;
    out property <string> mono: "Consolas";

    // Icon font — Segoe Fluent Icons ships with Windows 11 (Segoe MDL2 Assets on
    // Windows 10 shares the same private-use codepoints), so these monochrome
    // glyphs render reliably and match the minimal theme. The default UI font
    // lacks coverage for the geometric symbols we used before (they showed as
    // missing-glyph boxes), so every icon Text sets `font-family: Theme.icon-font`.
    out property <string> icon-font: "Segoe Fluent Icons";
    out property <string> ico-copy:           "\u{E8C8}";
    out property <string> ico-open:           "\u{E8A7}"; // OpenInNewWindow
    out property <string> ico-delete:         "\u{E74D}";
    out property <string> ico-settings:       "\u{E713}";
    out property <string> ico-light:          "\u{E706}"; // Brightness (sun)
    out property <string> ico-dark:           "\u{E708}"; // QuietHours (moon)
    out property <string> ico-chevron-down:   "\u{E70D}";
    out property <string> ico-chevron-right:  "\u{E76C}";
    out property <string> ico-check:          "\u{E73E}";

    // Status color from an identifier ("ok"/"warn"/"down"/"idle"/"host"/"provisioning").
    pure public function status-color(s: string) -> color {
        s == "ok"           ? ok :
        s == "warn"         ? warn :
        s == "down"         ? down :
        s == "host"         ? accent :
        s == "provisioning" ? provisioning :
        idle
    }
}
