// Modal overlay dialogs for managing groups and ports.
// Each dialog is a full-window backdrop with a centered themed card;
// visibility is driven by the `open` property bound from AppWindow.
// Enter confirms, Esc cancels (FocusScope in DialogShell).
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { TxtButton } from "controls.slint";
import { Field, Select, Check, Collapsible } from "field.slint";

// One group entry for the "Add port" group picker. Kept here so both the
// dialog and the AppWindow share the type.
export struct GroupItem {
    name: string,
    tunnel-id: string,
}

// Shared modal chrome: dimmed backdrop + centered card + keyboard handling.
component DialogShell inherits Rectangle {
    in property <string> title;
    in-out property <bool> open;
    // Enter anywhere in the dialog.
    callback confirm();
    // Esc anywhere in the dialog (the shell already closed itself).
    callback dismissed();

    visible: root.open;
    background: Theme.scrim;

    changed open => {
        if (root.open) {
            fs.focus();
        }
    }

    // Absorb clicks on the backdrop.
    TouchArea { }

    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.open = false;
                root.dismissed();
                return accept;
            }
            if (e.text == Key.Return) {
                root.confirm();
                return accept;
            }
            reject
        }

        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Theme.dialog-width;
            height: body.preferred-height;
            background: Theme.surface-2;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius;

            // Keep clicks inside the card from reaching the backdrop.
            TouchArea { }

            body := VerticalLayout {
                padding: Theme.pad + Theme.gap-sm;
                spacing: Theme.pad;

                if root.title != "" : Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.fs-section;
                    font-weight: 700;
                }

                @children
            }
        }
    }
}

// ---- New group ----
export component CreateGroupDialog inherits Rectangle {
    in-out property <bool> open;
    // Pre-filled expiration (issue #6): follows Settings.default_expiration.
    in property <string> default-expiration: "30d";
    callback submit(string /*name*/, string /*expiration*/, bool /*anonymous*/,
                    string /*description*/, bool /*keep-headers*/, string /*request-timeout*/);
    callback cancel();

    // Reset to defaults every time the dialog opens.
    changed open => {
        if (root.open) {
            name-f.text = "";
            exp-f.text = root.default-expiration;
            anon-c.checked = true;
            desc-f.text = "";
            kh-c.checked = false;
            to-f.text = "";
            adv.expanded = false;
        }
    }

    function do-submit() {
        root.submit(name-f.text, exp-f.text, anon-c.checked,
                    desc-f.text, kh-c.checked, to-f.text);
        root.open = false;
    }

    DialogShell {
        width: 100%;
        height: 100%;
        open <=> root.open;
        title: Strings.dlg-new-group-title;
        confirm => {
            root.do-submit();
        }
        dismissed => {
            root.cancel();
        }

        name-f := Field {
            label: Strings.field-name;
            placeholder: Strings.ph-group-name;
            accepted => {
                root.do-submit();
            }
        }
        exp-f := Field {
            label: Strings.field-expiration;
            placeholder: Strings.ph-expiration;
            text: root.default-expiration;
            accepted => {
                root.do-submit();
            }
        }
        anon-c := Check {
            text: Strings.field-anonymous;
            checked: true;
        }
        desc-f := Field {
            label: Strings.field-description;
            placeholder: Strings.ph-description;
            accepted => {
                root.do-submit();
            }
        }
        adv := Collapsible {
            title: Strings.dlg-advanced;
            kh-c := Check { text: Strings.dlg-keep-headers; }
            to-f := Field {
                label: Strings.dlg-request-timeout;
                placeholder: Strings.ph-request-timeout;
                number-only: true;
                accepted => {
                    root.do-submit();
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            alignment: end;
            TxtButton {
                text: Strings.btn-cancel;
                clicked => {
                    root.open = false;
                    root.cancel();
                }
            }
            TxtButton {
                text: Strings.btn-create;
                primary: true;
                clicked => {
                    root.do-submit();
                }
            }
        }
    }
}

// ---- Add port ----
export component AddPortDialog inherits Rectangle {
    in-out property <bool> open;
    // Parallel arrays: existing groups first, then the "+ New group…" entry last
    // (its id is empty, signalling "create a new group from `new-name`").
    in property <[string]> group-names;
    in property <[string]> group-ids;
    callback submit(string /*group-id*/, string /*new-name*/, string /*port*/,
                    string /*protocol*/, string /*description*/, bool /*keep-headers*/, string /*request-timeout*/);
    callback cancel();

    property <string> selected-id: root.group-ids[group-s.current-index];
    // State for the field nested in an `if` block (its id isn't reachable here).
    property <string> newname-val: "";

    changed open => {
        if (root.open) {
            group-s.current-index = 0;
            root.newname-val = "";
            port-f.text = "";
            proto-s.current-index = 0;
            desc-f.text = "";
            kh-c.checked = false;
            to-f.text = "";
            adv.expanded = false;
        }
    }

    function do-submit() {
        root.submit(root.selected-id, root.newname-val, port-f.text,
                    proto-s.current-value, desc-f.text, kh-c.checked, to-f.text);
        root.open = false;
    }

    DialogShell {
        width: 100%;
        height: 100%;
        open <=> root.open;
        title: Strings.dlg-add-port-title;
        confirm => {
            root.do-submit();
        }
        dismissed => {
            root.cancel();
        }

        group-s := Select {
            label: Strings.field-group;
            model: root.group-names;
        }

        // Only when the "+ New group…" entry (empty id) is selected.
        if root.selected-id == "" : Field {
            label: Strings.field-name;
            placeholder: Strings.ph-group-name;
            text <=> root.newname-val;
            accepted => {
                root.do-submit();
            }
        }

        port-f := Field {
            label: Strings.field-port;
            placeholder: Strings.ph-port;
            number-only: true;
            // Fast path: type a port number and press Enter.
            accepted => {
                root.do-submit();
            }
        }

        proto-s := Select {
            label: Strings.field-protocol;
            model: ["auto", "http", "https"];
        }

        desc-f := Field {
            label: Strings.field-description;
            placeholder: Strings.ph-description;
            accepted => {
                root.do-submit();
            }
        }

        adv := Collapsible {
            title: Strings.dlg-advanced;
            kh-c := Check { text: Strings.dlg-keep-headers; }
            to-f := Field {
                label: Strings.dlg-request-timeout;
                placeholder: Strings.ph-request-timeout;
                number-only: true;
                accepted => {
                    root.do-submit();
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            alignment: end;
            TxtButton {
                text: Strings.btn-cancel;
                clicked => {
                    root.open = false;
                    root.cancel();
                }
            }
            TxtButton {
                text: Strings.btn-add;
                primary: true;
                clicked => {
                    root.do-submit();
                }
            }
        }
    }
}

// ---- Confirmation (delete group/port) ----
// The message is composed in Rust (parametric, localized) and bound to
// `Strings.confirm-message`. On accept the dialog calls `accept()`.
export component ConfirmDialog inherits Rectangle {
    in-out property <bool> open;
    callback accept();
    callback cancel();

    function do-accept() {
        root.open = false;
        root.accept();
    }

    DialogShell {
        width: 100%;
        height: 100%;
        open <=> root.open;
        confirm => {
            root.do-accept();
        }
        dismissed => {
            root.cancel();
        }

        Text {
            text: Strings.confirm-message;
            color: Theme.text;
            font-size: Theme.fs-body;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.gap;
            alignment: end;
            TxtButton {
                text: Strings.btn-cancel;
                clicked => {
                    root.open = false;
                    root.cancel();
                }
            }
            TxtButton {
                text: Strings.btn-delete;
                danger: true;
                clicked => {
                    root.do-accept();
                }
            }
        }
    }
}
