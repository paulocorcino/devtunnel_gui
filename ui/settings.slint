// Settings dialog (issue #5): app-level options on the shared modal chrome.
// Uses the same DialogShell + themed Field/Check controls as the create/add
// dialogs so it matches the rest of the app (the old std-widgets LineEdit and
// CheckBox ignored the theme and rendered as oversized light boxes).
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { TxtButton } from "controls.slint";
import { Field, DaysField, Check } from "field.slint";
import { DialogShell } from "dialogs.slint";

export component SettingsDialog inherits Rectangle {
    in-out property <bool> open;
    // Current "start with Windows" state; set from Rust before opening and
    // toggled by the checkbox (Rust applies the registry change).
    in-out property <bool> auto-start;
    callback auto-start-changed(bool);
    // Health probe steady-state cadence in seconds; set from Rust before
    // opening, re-applied to the live probe on change (issue #6).
    in-out property <int> probe-interval;
    callback probe-interval-changed(int);
    // Default expiration for new groups and the renewal target, in days (issue #6).
    in-out property <int> default-expiration-days;
    callback default-expiration-changed(int /*days*/);

    // Re-seed the editors from the Rust-set properties every time the dialog
    // opens (a manual edit severs a plain binding, so reset explicitly).
    changed open => {
        if (root.open) {
            probe-f.text = root.probe-interval;
            exp-f.text = root.default-expiration-days;
        }
    }

    function commit-probe() {
        if (probe-f.text.is-float()) {
            root.probe-interval = probe-f.text.to-float();
            root.probe-interval-changed(root.probe-interval);
        }
    }
    function commit-expiration() {
        root.default-expiration-days = exp-f.days;
        root.default-expiration-changed(exp-f.days);
    }

    DialogShell {
        width: 100%;
        height: 100%;
        open <=> root.open;
        title: Strings.settings-title;
        confirm => {
            root.open = false;
        }

        Check {
            text: Strings.field-auto-start;
            checked <=> root.auto-start;
            toggled(on) => {
                root.auto-start-changed(on);
            }
        }

        probe-f := Field {
            label: Strings.field-probe-interval;
            number-only: true;
            edited => {
                root.commit-probe();
            }
            accepted => {
                root.commit-probe();
            }
        }

        exp-f := DaysField {
            label: Strings.field-default-expiration;
            edited => {
                root.commit-expiration();
            }
            accepted => {
                root.commit-expiration();
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            alignment: end;
            TxtButton {
                text: Strings.btn-close;
                primary: true;
                clicked => {
                    root.open = false;
                }
            }
        }
    }
}
