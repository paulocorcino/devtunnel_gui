// Settings dialog (issue #5): app-level options on the shared modal chrome.
// Laid out as a left nav rail (General / Status / About) over a content pane so
// the requirements checklist and About blurb no longer clutter the actual
// settings. Uses the same DialogShell + themed Field/Check/Select controls as the
// create/add dialogs so it matches the rest of the app.
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { TxtButton } from "controls.slint";
import { Field, DaysField, Check, Select } from "field.slint";
import { DialogShell } from "dialogs.slint";

// Clickable inline link rendered in the accent color. Opens an external URL
// via the AppWindow's open-url callback (handled by Rust through the `open` crate).
component Link inherits Text {
    callback clicked();
    color: Theme.accent;
    font-size: Theme.fs-caption;
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One entry in the left nav rail: accent + bold when active.
component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: Theme.btn-height;
    background: root.active ? Theme.surface : transparent;
    border-radius: Theme.gap-sm;

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        Text {
            text: root.text;
            color: root.active ? Theme.accent : Theme.text;
            font-size: Theme.fs-body;
            font-weight: root.active ? 700 : 400;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// One row of the requirements checklist: a status glyph (✓ green / ✗ red), a
// label, and an optional action button supplied as a child (shown by the caller
// only when the requirement is not satisfied).
component ReqRow inherits HorizontalLayout {
    in property <bool> ok;
    in property <string> label;
    spacing: Theme.gap;
    Text {
        text: root.ok ? Theme.ico-check : Theme.ico-x;
        font-family: Theme.icon-font;
        color: root.ok ? Theme.ok : Theme.down;
        font-size: Theme.fs-body;
        vertical-alignment: center;
    }
    Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.fs-body;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    @children
}

export component SettingsDialog inherits Rectangle {
    in-out property <bool> open;
    // App version (from Cargo) shown in the About panel.
    in property <string> app-version;
    // Requirements checklist state (set from Rust each time the dialog opens).
    in property <bool> req-cli-ok;
    in property <bool> req-login-ok;
    // Logged-in account (e.g. an email); empty when logged out or not yet fetched.
    in property <string> req-login-account;
    in property <bool> req-installed-ok;
    in property <bool> req-autostart-ok;
    // True while the CLI install (winget) is running — disables the Install CLI
    // button and swaps its label for "Installing…", matching the banner.
    in property <bool> installing;
    // Requirements actions.
    callback install-cli();
    callback sign-in();
    // The user clicked "Uninstall" (only shown when the app is installed). The
    // AppWindow opens a confirmation dialog before anything is removed.
    callback uninstall();
    // Open an external URL in the browser (forwarded to AppWindow.open-url).
    callback open-url(string);
    // Current "start with Windows" state; set from Rust before opening and
    // toggled by the checkbox (Rust applies the registry change).
    in-out property <bool> auto-start;
    callback auto-start-changed(bool);
    // Health probe steady-state cadence in seconds; set from Rust before
    // opening, re-applied to the live probe on change (issue #6).
    in-out property <int> probe-interval;
    callback probe-interval-changed(int);
    // Default expiration for new groups and the renewal target, in days (issue #6).
    in-out property <int> default-expiration-days;
    callback default-expiration-changed(int /*days*/);
    // Minimum severity shown in the Logs tab ("error"/"warn"/"info"/"debug").
    in-out property <string> log-level: "info";
    callback log-level-changed(string);

    // Active nav section: 0 = General, 1 = Status, 2 = About.
    property <int> section: 0;

    // Editable field state lives on root (not on element ids) because the inputs
    // are nested inside `if section == …` blocks, whose ids are not reachable
    // from the component's functions. Each field binds two-way to one of these.
    property <string> probe-text;
    property <string> exp-text;
    property <int> loglevel-index: 2;

    // Clamp helper mirroring DaysField (min 1, max 30 days).
    pure function exp-days() -> int {
        Math.max(Math.min(root.exp-text.to-float(), 30), 1)
    }
    // Map the persisted log-level enum to/from the Select index.
    pure function level-index(s: string) -> int {
        s == "error" ? 0 : (s == "warn" ? 1 : (s == "debug" ? 3 : 2))
    }
    pure function index-level(i: int) -> string {
        i == 0 ? "error" : (i == 1 ? "warn" : (i == 3 ? "debug" : "info"))
    }

    // Re-seed the editors from the Rust-set properties every time the dialog
    // opens (a manual edit severs a plain binding, so reset explicitly).
    changed open => {
        if (root.open) {
            root.probe-text = root.probe-interval;
            root.exp-text = root.default-expiration-days;
            root.loglevel-index = root.level-index(root.log-level);
            root.section = 0;
        }
    }
    // Emit the log-level change when the picker moves.
    changed loglevel-index => {
        root.log-level = root.index-level(root.loglevel-index);
        root.log-level-changed(root.log-level);
    }

    function commit-probe() {
        if (root.probe-text.is-float()) {
            root.probe-interval = root.probe-text.to-float();
            root.probe-interval-changed(root.probe-interval);
        }
    }
    function commit-expiration() {
        root.default-expiration-days = root.exp-days();
        root.default-expiration-changed(root.exp-days());
    }

    DialogShell {
        width: 100%;
        height: 100%;
        card-width: Theme.settings-dialog-width;
        open <=> root.open;
        title: Strings.settings-title;
        confirm => {
            root.open = false;
        }

        HorizontalLayout {
            spacing: Theme.pad;

            // ---- Left nav rail ----
            VerticalLayout {
                width: Theme.settings-nav-width;
                spacing: Theme.gap-sm;
                alignment: start;
                NavItem {
                    text: Strings.settings-section-general;
                    active: root.section == 0;
                    clicked => {
                        root.section = 0;
                    }
                }
                NavItem {
                    text: Strings.settings-section-status;
                    active: root.section == 1;
                    clicked => {
                        root.section = 1;
                    }
                }
                NavItem {
                    text: Strings.settings-section-about;
                    active: root.section == 2;
                    clicked => {
                        root.section = 2;
                    }
                }
            }

            // Divider between rail and content.
            Rectangle {
                width: 1px;
                background: Theme.border;
            }

            // ---- Content pane ----
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.gap;

                // -- General --
                if root.section == 0 : VerticalLayout {
                    spacing: Theme.gap;
                    // Auto-start is managed by the MSIX package (windows.startupTask,
                    // toggled in Windows Settings) in Store builds, so hide this toggle there.
                    if !Strings.store-build: Check {
                        text: Strings.field-auto-start;
                        checked <=> root.auto-start;
                        toggled(on) => {
                            root.auto-start-changed(on);
                        }
                    }
                    Field {
                        label: Strings.field-probe-interval;
                        number-only: true;
                        text <=> root.probe-text;
                        edited => {
                            root.commit-probe();
                        }
                        accepted => {
                            root.commit-probe();
                        }
                    }
                    DaysField {
                        label: Strings.field-default-expiration;
                        text <=> root.exp-text;
                        edited => {
                            root.commit-expiration();
                        }
                        accepted => {
                            root.commit-expiration();
                        }
                    }
                    Select {
                        label: Strings.field-log-level;
                        current-index <=> root.loglevel-index;
                        model: [
                            Strings.log-level-error,
                            Strings.log-level-warn,
                            Strings.log-level-info,
                            Strings.log-level-debug,
                        ];
                    }
                }

                // -- Status (requirements + uninstall) --
                if root.section == 1 : VerticalLayout {
                    spacing: Theme.gap-sm;
                    Text {
                        text: Strings.req-title;
                        color: Theme.text;
                        font-size: Theme.fs-section;
                        font-weight: 700;
                    }
                    ReqRow {
                        ok: root.req-cli-ok;
                        label: Strings.req-cli;
                        // The winget-based installer can't run from the MSIX sandbox
                        // (and invoking external installers is against Store policy),
                        // so Store builds omit the button; the row still flags the CLI.
                        if !root.req-cli-ok && !Strings.store-build: TxtButton {
                            text: root.installing ? Strings.install-status-running : Strings.btn-install-cli;
                            enabled: !root.installing;
                            clicked => {
                                root.install-cli();
                            }
                        }
                    }
                    ReqRow {
                        ok: root.req-login-ok;
                        label: root.req-login-ok && root.req-login-account != ""
                            ? Strings.req-login-as + " " + root.req-login-account
                            : Strings.req-login;
                        if !root.req-login-ok: TxtButton {
                            text: Strings.btn-sign-in;
                            clicked => {
                                root.sign-in();
                            }
                        }
                    }
                    // Auto-start state and the uninstall action only apply to the
                    // portable build. In Store builds the MSIX package owns install
                    // and removal, so hide this whole block.
                    if !Strings.store-build: ReqRow {
                        ok: root.req-autostart-ok;
                        label: Strings.req-autostart;
                    }
                    // Danger zone: uninstall (only meaningful for an app copy that
                    // was relocated into the programs folder under the old model).
                    if !Strings.store-build && root.req-installed-ok: Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    if !Strings.store-build && root.req-installed-ok: HorizontalLayout {
                        alignment: start;
                        TxtButton {
                            text: Strings.btn-uninstall;
                            danger: true;
                            clicked => {
                                root.uninstall();
                            }
                        }
                    }
                }

                // -- About --
                if root.section == 2 : VerticalLayout {
                    spacing: Theme.gap-sm;
                    Text {
                        text: Strings.about-title;
                        color: Theme.text;
                        font-size: Theme.fs-section;
                        font-weight: 700;
                    }
                    Text {
                        text: Strings.about-app-name + " · " + Strings.about-version-label + " " + root.app-version;
                        color: Theme.text;
                        font-size: Theme.fs-body;
                    }
                    Text {
                        text: Strings.about-tagline;
                        color: Theme.muted;
                        font-size: Theme.fs-caption;
                        wrap: word-wrap;
                    }
                    Text {
                        text: Strings.about-built-on;
                        color: Theme.muted;
                        font-size: Theme.fs-caption;
                        wrap: word-wrap;
                    }
                    Text {
                        text: Strings.about-created-by;
                        color: Theme.text;
                        font-size: Theme.fs-caption;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap;
                        alignment: start;
                        Link {
                            text: Strings.about-link-docs;
                            clicked => {
                                root.open-url("https://learn.microsoft.com/azure/developer/dev-tunnels/overview");
                            }
                        }
                        Link {
                            text: Strings.about-link-repo;
                            clicked => {
                                root.open-url("https://github.com/paulocorcino/devtunnel_gui");
                            }
                        }
                        Link {
                            text: Strings.about-link-license;
                            clicked => {
                                root.open-url("https://github.com/paulocorcino/devtunnel_gui/blob/main/LICENSE");
                            }
                        }
                    }
                }
            }
        }

        // ---- Footer ----
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }
            TxtButton {
                text: Strings.btn-close;
                primary: true;
                clicked => {
                    root.open = false;
                }
            }
        }
    }
}
