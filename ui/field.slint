// Themed form controls for dialogs: Field (labeled text input), Select
// (dropdown), Check (checkbox), and Collapsible (expandable section).
// These replace the bare std-widgets, which ignore the app Theme.
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";

// Labeled numeric "days" input with a trailing unit and a hard cap. The value
// is days only — the CLI's "d" suffix is implicit (added in Rust) and the field
// clamps to [minimum, maximum] so an expiration can never exceed the service
// limit (30 days). Consumers seed `text` from an int and read the clamped `days`.
export component DaysField inherits VerticalLayout {
    in property <string> label;
    in property <int> minimum: 1;
    in property <int> maximum: 30;
    in-out property <string> text;
    // Parsed + clamped value the consumer should use on submit.
    out property <int> days: Math.max(Math.min(root.text.to-float(), root.maximum), root.minimum);
    callback accepted();
    callback edited();

    spacing: Theme.gap-sm;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: Theme.fs-caption;
    }

    Rectangle {
        height: Theme.btn-height;
        background: Theme.bg;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        border-radius: Theme.gap-sm;

        HorizontalLayout {
            padding-left: Theme.gap;
            padding-right: Theme.gap;
            spacing: Theme.gap-sm;

            input := TextInput {
                horizontal-stretch: 1;
                height: 100%;
                vertical-alignment: center;
                color: Theme.text;
                font-size: Theme.fs-body;
                single-line: true;
                input-type: number;
                text <=> root.text;
                edited => {
                    root.edited();
                }
                accepted => {
                    // Normalize the displayed value to the clamped result.
                    root.text = root.days;
                    root.accepted();
                }
                // Snap the text to the clamped value when focus leaves, so a
                // typed "99" visibly becomes "30".
                changed has-focus => {
                    if (!self.has-focus) {
                        root.text = root.days;
                    }
                }
            }
            Text {
                text: Strings.unit-days;
                color: Theme.muted;
                font-size: Theme.fs-body;
                vertical-alignment: center;
            }
        }
    }
}

// Labeled single-line text input.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> number-only: false;
    callback accepted();
    // Fired on every keystroke (mirrors std-widgets LineEdit.edited).
    callback edited();

    spacing: Theme.gap-sm;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: Theme.fs-caption;
    }

    Rectangle {
        height: Theme.btn-height;
        background: Theme.bg;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        border-radius: Theme.gap-sm;

        input := TextInput {
            x: Theme.gap;
            width: parent.width - Theme.gap * 2;
            height: 100%;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.fs-body;
            single-line: true;
            input-type: root.number-only ? InputType.number : InputType.text;
            text <=> root.text;
            accepted => {
                root.accepted();
            }
            edited => {
                root.edited();
            }
        }
        if root.text == "" : Text {
            x: Theme.gap;
            height: 100%;
            text: root.placeholder;
            color: Theme.muted;
            font-size: Theme.fs-body;
            vertical-alignment: center;
        }
    }
}

// Labeled dropdown picker.
export component Select inherits VerticalLayout {
    in property <string> label;
    in property <[string]> model;
    in-out property <int> current-index: 0;
    out property <string> current-value: root.model[root.current-index];

    spacing: Theme.gap-sm;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: Theme.fs-caption;
    }

    box := Rectangle {
        height: Theme.btn-height;
        background: Theme.bg;
        border-width: 1px;
        border-color: ta.has-hover ? Theme.accent : Theme.border;
        border-radius: Theme.gap-sm;

        HorizontalLayout {
            padding-left: Theme.gap;
            padding-right: Theme.gap;
            spacing: Theme.gap;
            Text {
                text: root.current-value;
                color: Theme.text;
                font-size: Theme.fs-body;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: Theme.ico-chevron-down;
                font-family: Theme.icon-font;
                color: Theme.muted;
                font-size: Theme.fs-caption;
                vertical-alignment: center;
            }
        }

        ta := TouchArea {
            clicked => {
                popup.show();
            }
        }

        popup := PopupWindow {
            x: 0;
            y: parent.height + Theme.gap-sm;
            width: parent.width;

            Rectangle {
                background: Theme.surface-2;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.gap-sm;

                VerticalLayout {
                    padding: Theme.gap-sm;
                    for value[i] in root.model : Rectangle {
                        height: Theme.btn-height;
                        background: ita.has-hover ? Theme.surface : transparent;
                        border-radius: Theme.gap-sm;
                        ita := TouchArea {
                            clicked => {
                                root.current-index = i;
                            }
                        }
                        HorizontalLayout {
                            padding-left: Theme.gap;
                            padding-right: Theme.gap;
                            Text {
                                text: value;
                                color: i == root.current-index ? Theme.accent : Theme.text;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Checkbox with a label.
export component Check inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    // Fired with the new state when the user clicks the checkbox.
    callback toggled(bool);

    height: Theme.toggle-height;

    HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;
        box := Rectangle {
            width: Theme.toggle-height * 0.8;
            height: Theme.toggle-height * 0.8;
            y: (parent.height - self.height) / 2;
            background: root.checked ? Theme.accent : Theme.bg;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.border;
            border-radius: Theme.gap-sm;
            Text {
                width: 100%;
                height: 100%;
                text: Theme.ico-check;
                font-family: Theme.icon-font;
                visible: root.checked;
                color: Theme.accent-text;
                font-size: Theme.fs-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.fs-body;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Expandable section (e.g. "Advanced"): clickable chevron header over content.
export component Collapsible inherits VerticalLayout {
    in property <string> title;
    in-out property <bool> expanded: false;

    spacing: Theme.gap;

    Rectangle {
        height: Theme.toggle-height;
        HorizontalLayout {
            spacing: Theme.gap-sm;
            alignment: start;
            Text {
                text: root.expanded ? Theme.ico-chevron-down : Theme.ico-chevron-right;
                font-family: Theme.icon-font;
                color: Theme.muted;
                font-size: Theme.fs-caption;
                vertical-alignment: center;
            }
            Text {
                text: root.title;
                color: Theme.muted;
                font-size: Theme.fs-caption;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        TouchArea {
            clicked => {
                root.expanded = !root.expanded;
            }
        }
    }

    content := Rectangle {
        clip: true;
        height: root.expanded ? inner.preferred-height : 0;
        animate height { duration: 120ms; easing: ease-out; }
        inner := VerticalLayout {
            width: 100%;
            spacing: Theme.gap;
            @children
        }
    }
}
